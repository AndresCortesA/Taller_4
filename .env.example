# Copie este archivo como .env y ajuste los valores si lo necesita.
# Si no existe .env, la aplicación usa estos mismos valores por defecto.

# Nombre que aparece en los reportes y en el log
FJ_NOMBRE_APP=Software FJ

# Ruta del archivo de logs (relativa a la raíz del proyecto o absoluta)
FJ_ARCHIVO_LOG=logs/software_fj.log

# Nivel mínimo de registro: DEBUG, INFO, WARNING, ERROR o CRITICAL
FJ_NIVEL_LOG=INFO

# Impuesto aplicado al procesar una reserva (0.19 = IVA del 19 %)
FJ_TASA_IMPUESTO=0.19

# Duración máxima de cualquier reserva, en horas
FJ_MAX_HORAS_RESERVA=72
